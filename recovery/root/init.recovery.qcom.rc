#
# Recovery init for the Xiaomi Mi 11 Pro (mars).
#
# Base: TeamWin/android_device_xiaomi_sm8350-common (android-11)
#         rootdir/etc/init.recovery.qcom.rc
# Plus: LineageOS/android_device_xiaomi_sm8350-common (lineage-23.2)
#         rootdir/etc/init.recovery.qcom.rc  -- the ADSP/firmware mount, which
#         is required on lahaina so that the PMIC firmware can be loaded.
#
# The `on fs` block is what makes /dev/block/bootdevice/by-name/* resolve on
# this platform (there is no static /dev/block/platform path before it).
# The qcom_decrypt package (PRODUCT_PACKAGES += qcom_decrypt qcom_decrypt_fbe)
# installs /init.recovery.qcom_decrypt.rc and is supposed to add this import
# itself; device/qcom/twrp-common/Android.mk only tries TARGET_ROOT_OUT,
# TARGET_RECOVERY_ROOT_OUT and a path relative to the recipe cwd, and on this
# build system none of them works (the appended file is overwritten when the
# ramdisk is assembled), so the import is kept here in the device tree.
# Without it init never parses the file and NONE of the decryption services
# (qseecomd, keymaster-4-1-qti, gatekeeper-1-0-qti) exists.
import /init.recovery.qcom_decrypt.rc

#

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Load ADSP firmware for PMIC (needed on lahaina)
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro context=u:object_r:firmware_file:s0

on init
    setprop sys.usb.configfs 1
    # v4: UDC name, belt-and-braces.  It normally arrives via
    # androidboot.usbcontroller (see the note in BoardConfig.mk), but the
    # boot image cmdline has already been observed to lose it; without a
    # UDC the configfs gadget is never bound and no USB device appears
    # (no adb / no MTP / sideload hangs).
    setprop sys.usb.controller a600000.dwc3

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

# v4.1: the cgroup directories that the recovery task profiles join.
# SCHED_SP_BACKGROUND (used by logd at startup) joins cpu/background and
# blkio/background; libprocessgroup's SetCgroupAction only *opens*
# <controller>/<path>/cgroup.procs, it never creates the directory, and the
# recovery cgroups.json lists controllers only.  Created in `on fs`, i.e. after
# logd's first (failing) start; init restarts logd and it then comes up.
# is started at `on init` (before these mounts are usable) and init restarts it,
# so it comes up on one of the following attempts.
on fs
    mkdir /dev/cpuctl/background 0770 system system
    mkdir /dev/cpuctl/foreground 0770 system system
    mkdir /dev/blkio/background 0770 system system
    mkdir /dev/blkio/foreground 0770 system system

on property:dev.mnt.blk.firmware=*
    write /sys/kernel/boot_adsp/boot 1

on property:init.svc.fastbootd=running
    umount /firmware
